---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppNavBar from '../components/layout/AppNavBar.astro';
import StoreFooter from '../components/StoreFooter.astro';
import GooeyNavMenu from '../components/islands/GooeyNavMenu.svelte';
import CorePillars from '../components/shared/CorePillars.astro';
import catalogData from '../data/catalog.json';
import type { FlowerProduct, StudioInfo } from '../domain/types';
import { generateFloristJsonLd } from '../infrastructure/seo-schema';
import { createWhatsAppConsultLink } from '../application/whatsapp';

const studio: StudioInfo = catalogData.studio;
const products: readonly FlowerProduct[] = catalogData.products as FlowerProduct[];
const jsonLd = generateFloristJsonLd(studio, products);
const consultWaUrl = createWhatsAppConsultLink(studio, 'Konsultasi Panduan Order');
---

<BaseLayout
  title={`Panduan Pemesanan & Pengiriman — ${studio.name}`}
  description={`Panduan lengkap pemesanan buket bunga di Slawi, Tegal & Brebes. Pengiriman Sameday, kartu ucapan segel lilin gratis, dan garansi keamanan packaging.`}
  jsonLd={jsonLd}
>
  <div id="top" class="min-h-screen flex flex-col bg-atelier-bg text-atelier-text">
    <AppNavBar studio={studio} currentPath="/panduan" totalProducts={products.length} />

    <main class="flex-1 pt-8 pb-24 sm:py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 sm:space-y-14">
        <!-- Page Header -->
        <div class="text-center space-y-3">
          <span class="inline-flex items-center gap-1.5 font-sans text-xs font-bold px-3.5 py-1 rounded-full bg-softBlue-200 text-softBlue-950 border-2 border-softBlue-400 shadow-2xs">
            Prosedur Resmi Atelier
          </span>
          <h1 class="font-serif text-3xl sm:text-4xl font-extrabold text-stone-900 tracking-tight">
            Panduan Pemesanan & Pengiriman
          </h1>
          <p class="font-sans text-sm sm:text-base text-stone-600 max-w-xl mx-auto leading-relaxed">
            Layanan pemesanan buket bunga profesional dengan garansi bunga mekar sempurna, proteksi box kokoh, dan pengiriman tepat waktu di Slawi, Tegal, & Brebes.
          </p>
        </div>

        <!-- 3-Step WhatsApp Order Flow -->
        <section class="space-y-6">
          <div class="border-b border-stone-200 pb-3">
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-stone-900 flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-softGreen-200 text-softGreen-950 border-2 border-softGreen-400 flex items-center justify-center text-xs font-sans font-extrabold">1</span>
              <span>Alur Pemesanan Cepat via WhatsApp</span>
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Step 1 -->
            <div class="p-5 rounded-2xl bg-white border-2 border-stone-200 shadow-2xs flex flex-col justify-between space-y-3">
              <div class="space-y-2">
                <span class="text-xs font-serif font-bold text-softPink-950 bg-softPink-200 px-2.5 py-0.5 rounded-full border border-softPink-400 inline-block">
                  Langkah 01
                </span>
                <h3 class="font-serif font-bold text-base text-stone-900">Pilih Rangkaian Buket</h3>
                <p class="text-xs text-stone-600 leading-relaxed font-sans">
                  Telusuri <a href="/koleksi" class="text-softGreen-800 font-bold underline">katalog koleksi</a> kami. Catat kode rangkaian (contoh: <strong>PSF-WED-01</strong>) atau klik tombol <em>Pesan via WhatsApp</em> pada buket pilihan Anda.
                </p>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="p-5 rounded-2xl bg-white border-2 border-stone-200 shadow-2xs flex flex-col justify-between space-y-3">
              <div class="space-y-2">
                <span class="text-xs font-serif font-bold text-softGreen-950 bg-softGreen-200 px-2.5 py-0.5 rounded-full border border-softGreen-400 inline-block">
                  Langkah 02
                </span>
                <h3 class="font-serif font-bold text-base text-stone-900">Konsultasi & Kartu Ucapan</h3>
                <p class="text-xs text-stone-600 leading-relaxed font-sans">
                  Kirimkan pesan ucapan untuk dicetak di <strong>kartu bersegel lilin gratis</strong>. Anda juga dapat mendiskusikan warna wrapping, nuansa pita, atau penyesuaian khusus.
                </p>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="p-5 rounded-2xl bg-white border-2 border-stone-200 shadow-2xs flex flex-col justify-between space-y-3">
              <div class="space-y-2">
                <span class="text-xs font-serif font-bold text-softYellow-950 bg-softYellow-200 px-2.5 py-0.5 rounded-full border border-softYellow-400 inline-block">
                  Langkah 03
                </span>
                <h3 class="font-serif font-bold text-base text-stone-900">Pengiriman / Ambil di Studio</h3>
                <p class="text-xs text-stone-600 leading-relaxed font-sans">
                  Konfirmasi pembayaran via QRIS / Transfer. Rangkaian dirangkai fresh dan dikirim oleh kurir khusus atau dapat diambil di Ruko Kirana Lestari D5 Slawi.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Delivery Radius Table -->
        <section class="space-y-6">
          <div class="border-b border-stone-200 pb-3">
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-stone-900 flex items-center gap-2.5">
              <span class="w-7 h-7 rounded-lg bg-softBlue-200 text-softBlue-950 border-2 border-softBlue-400 flex items-center justify-center text-xs font-sans font-extrabold">2</span>
              <span>Cakupan Wilayah & Estimasi Pengiriman</span>
            </h2>
          </div>

          <div class="overflow-hidden rounded-2xl border-2 border-stone-200 bg-white shadow-2xs">
            <table class="w-full text-left text-xs font-sans">
              <thead class="bg-stone-100 text-stone-800 uppercase font-bold text-[10px] tracking-wider border-b border-stone-200">
                <tr>
                  <th class="p-3.5 sm:p-4">Wilayah Tujuan</th>
                  <th class="p-3.5 sm:p-4">Jenis Layanan</th>
                  <th class="p-3.5 sm:p-4">Waktu Sampai</th>
                  <th class="p-3.5 sm:p-4">Jenis Rangkaian</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-stone-100 text-stone-700">
                <tr class="hover:bg-softGreen-50/50">
                  <td class="p-3.5 sm:p-4 font-bold text-stone-900">Slawi & Sekitarnya</td>
                  <td class="p-3.5 sm:p-4">
                    <span class="px-2.5 py-1 rounded-full bg-softGreen-200 text-softGreen-950 font-bold border border-softGreen-400">Kurir Instan / Sameday</span>
                  </td>
                  <td class="p-3.5 sm:p-4">1 - 2 Jam (Slot Ready)</td>
                  <td class="p-3.5 sm:p-4">Segar, Abadi & Custom</td>
                </tr>
                <tr class="hover:bg-softPink-50/50">
                  <td class="p-3.5 sm:p-4 font-bold text-stone-900">Kota Tegal & Kab. Tegal</td>
                  <td class="p-3.5 sm:p-4">
                    <span class="px-2.5 py-1 rounded-full bg-softPink-200 text-softPink-950 font-bold border border-softPink-400">Sameday & Terjadwal</span>
                  </td>
                  <td class="p-3.5 sm:p-4">2 - 3 Jam</td>
                  <td class="p-3.5 sm:p-4">Segar, Abadi & Custom</td>
                </tr>
                <tr class="hover:bg-softBlue-50/50">
                  <td class="p-3.5 sm:p-4 font-bold text-stone-900">Brebes & Sekitarnya</td>
                  <td class="p-3.5 sm:p-4">
                    <span class="px-2.5 py-1 rounded-full bg-softBlue-200 text-softBlue-950 font-bold border border-softBlue-400">Kurir Terjadwal / Kargo</span>
                  </td>
                  <td class="p-3.5 sm:p-4">Sameday / Next Day</td>
                  <td class="p-3.5 sm:p-4">Segar, Abadi & Custom</td>
                </tr>
                <tr class="hover:bg-softYellow-50/50">
                  <td class="p-3.5 sm:p-4 font-bold text-stone-900">Luar Kota (Seluruh Indonesia)</td>
                  <td class="p-3.5 sm:p-4">
                    <span class="px-2.5 py-1 rounded-full bg-softYellow-200 text-softYellow-950 font-bold border border-softYellow-400">Ekspedisi Kargo Khusus</span>
                  </td>
                  <td class="p-3.5 sm:p-4">1 - 3 Hari Kerja</td>
                  <td class="p-3.5 sm:p-4">Bunga Abadi, Kering & Kawat Bulu</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Value Pillars -->
        <section class="space-y-4">
          <h2 class="font-serif text-lg font-bold text-stone-900">Standar Kualitas & Proteksi Pearl Store Flowers</h2>
          <CorePillars />
        </section>

        <!-- Direct CTA -->
        <div class="p-6 sm:p-8 rounded-3xl bg-softGreen-200 border-2 border-softGreen-400 text-center space-y-4 shadow-xs">
          <h3 class="font-serif text-2xl font-bold text-softGreen-950">Ada Pertanyaan Khusus Terkait Pemesanan?</h3>
          <p class="font-sans text-xs sm:text-sm text-softGreen-900 max-w-md mx-auto">
            Florist kami siap membantu memilihkan rangkaian terbaik yang sesuai dengan anggaran dan momen spesial Anda.
          </p>
          <a
            href={consultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-softGreen-900 hover:bg-softGreen-800 text-white font-sans text-xs font-bold border-2 border-softGreen-950 shadow-xs hover:scale-105 active:scale-95 transition-all"
          >
            <span>Konsultasi via WhatsApp Sekarang</span>
          </a>
        </div>
      </div>
    </main>

    <StoreFooter studio={studio} />
    <GooeyNavMenu client:idle studio={studio} currentPath="/panduan" />
  </div>
</BaseLayout>

