---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppNavBar from '../../components/layout/AppNavBar.astro';
import StoreFooter from '../../components/StoreFooter.astro';
import GooeyNavMenu from '../../components/islands/GooeyNavMenu.svelte';
import catalogData from '../../data/catalog.json';
import type { FlowerProduct, StudioInfo } from '../../domain/types';
import { generateSingleProductJsonLd } from '../../infrastructure/seo-schema';
import { createWhatsAppOrderLink } from '../../application/whatsapp';
import { optimizeImageUrl } from '../../application/image-optimizer';

export async function getStaticPaths() {
  const products = catalogData.products as FlowerProduct[];
  const studio = catalogData.studio as StudioInfo;

  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, studio, allProducts: products },
  }));
}

interface Props {
  product: FlowerProduct;
  studio: StudioInfo;
  allProducts: readonly FlowerProduct[];
}

const { product, studio, allProducts } = Astro.props;

const jsonLd = generateSingleProductJsonLd(studio, product);
const waOrderUrl = createWhatsAppOrderLink(product, studio.whatsappNumber, studio.name);
const optimizedHeroImage = product.imageUrl ? optimizeImageUrl(product.imageUrl, 1200, 85) : '';

// Related products in same category
const relatedProducts = allProducts
  .filter((p) => p.category === product.category && p.id !== product.id)
  .slice(0, 4);

function getCategoryBadgeClasses(cat: string): string {
  switch (cat) {
    case 'Wedding':
      return 'bg-softPink-200 text-softPink-950 border-2 border-softPink-400 font-bold shadow-2xs';
    case 'Engagement':
      return 'bg-softGreen-200 text-softGreen-950 border-2 border-softGreen-400 font-bold shadow-2xs';
    case 'Graduation':
      return 'bg-softBlue-200 text-softBlue-950 border-2 border-softBlue-400 font-bold shadow-2xs';
    case 'Custom':
      return 'bg-softYellow-200 text-softYellow-950 border-2 border-softYellow-400 font-bold shadow-2xs';
    default:
      return 'bg-stone-200 text-stone-900 border-2 border-stone-400 font-bold shadow-2xs';
  }
}
---

<BaseLayout
  title={`${product.title} (${product.code}) — ${studio.name}`}
  description={`${product.title}: ${product.description} Mulai dari ${product.priceDisplay}. Hubungi WhatsApp untuk reservasi slot pengiriman.`}
  ogImage={product.imageUrl}
  ogType="product"
  jsonLd={jsonLd}
>
  <div id="top" class="min-h-screen flex flex-col bg-atelier-bg text-atelier-text">
    <AppNavBar studio={studio} currentPath="/koleksi" totalProducts={allProducts.length} />

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 sm:py-10">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs font-sans text-stone-500 mb-6">
        <a href="/" class="hover:text-softGreen-800 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/koleksi" class="hover:text-softGreen-800 transition-colors">Koleksi Buket</a>
        <span>/</span>
        <span class="text-stone-400">{product.categoryLabel}</span>
        <span>/</span>
        <span class="text-stone-900 font-semibold">{product.code}</span>
      </nav>

      <!-- Main Product Showcase Grid (Zero Gradient Policy) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-stone-200/90 shadow-sm">
        <!-- Visual Gallery -->
        <div class="space-y-4">
          <div class="relative aspect-[4/5] rounded-2xl overflow-hidden bg-stone-100 shadow-xs border border-stone-200">
            {optimizedHeroImage && (
              <img
                src={optimizedHeroImage}
                alt={product.title}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
            )}
            <div class="absolute top-4 left-4 flex gap-2">
              <span class="font-sans text-xs font-semibold px-3 py-1 rounded-md bg-white/95 text-stone-900 shadow-xs border border-stone-200">
                {product.code}
              </span>
              <span class={`font-sans text-xs font-semibold px-3 py-1 rounded-md border shadow-xs ${getCategoryBadgeClasses(product.category)}`}>
                {product.categoryLabel}
              </span>
            </div>
          </div>

          <!-- Quality Notice in Solid Soft Green (Zero Gradient Policy) -->
          <div class="p-3.5 rounded-xl bg-softGreen-200 border-2 border-softGreen-400 text-xs text-softGreen-950 font-medium flex items-center gap-2.5 shadow-2xs">
            <svg class="w-4 h-4 text-softGreen-900 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <span class="leading-tight">
              Foto di atas adalah portofolio kurasi asli {studio.name}. Rangkaian Anda dirangkai segar menjelang pengiriman.
            </span>
          </div>
        </div>

        <!-- Product Details & Ordering CTA -->
        <div class="flex flex-col justify-between space-y-6">
          <div class="space-y-5">
            <div>
              <span class={`font-sans text-xs tracking-wider uppercase font-semibold px-3 py-1 rounded-md border inline-block mb-3 ${getCategoryBadgeClasses(product.category)}`}>
                {product.categoryLabel}
              </span>
              <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-stone-900 leading-tight">
                {product.title}
              </h1>
            </div>

            <!-- Price & Lead Time in Solid Soft Green -->
            <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200 flex items-baseline justify-between flex-wrap gap-2">
              <div>
                <span class="font-sans text-[11px] uppercase tracking-wider text-stone-500 block font-medium">
                  Harga Penawaran
                </span>
                <span class="font-serif text-3xl font-extrabold text-stone-900 tracking-tight">
                  {product.priceDisplay}
                </span>
              </div>
              <div class="text-right">
                <span class="font-sans text-[11px] uppercase tracking-wider text-stone-500 block font-medium">
                  Estimasi Pengerjaan
                </span>
                <span class="inline-flex items-center gap-1.5 font-sans text-xs font-bold text-softGreen-950 bg-softGreen-200 px-3 py-1 rounded-full border-2 border-softGreen-400 shadow-2xs">
                  <svg class="w-3.5 h-3.5 text-softGreen-900" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span>{product.leadTime}</span>
                </span>
              </div>
            </div>

            <!-- Description -->
            <div class="space-y-2">
              <h3 class="font-serif font-bold text-sm text-stone-900 tracking-tight">
                Deskripsi Rangkaian
              </h3>
              <p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
                {product.description}
              </p>
            </div>

            <!-- Specifications Table -->
            <div class="grid grid-cols-2 gap-3 text-xs">
              <div class="p-3.5 rounded-xl border border-stone-200 bg-white shadow-2xs">
                <span class="text-stone-400 font-sans text-[10px] tracking-wider uppercase font-semibold block mb-0.5">DIMENSI</span>
                <p class="font-semibold text-stone-800">{product.dimension}</p>
              </div>

              <div class="p-3.5 rounded-xl border border-stone-200 bg-white shadow-2xs">
                <span class="text-stone-400 font-sans text-[10px] tracking-wider uppercase font-semibold block mb-0.5">NUANSA WARNA</span>
                <p class="font-semibold text-stone-800">{product.colorTheme}</p>
              </div>

              <div class="col-span-2 p-3.5 rounded-xl border border-stone-200 bg-white shadow-2xs">
                <span class="text-stone-400 font-sans text-[10px] tracking-wider uppercase font-semibold block mb-0.5">MATERIAL WRAPPING</span>
                <p class="font-semibold text-stone-800">{product.wrappingMaterial}</p>
              </div>
            </div>

            <!-- Flower Composition Chips -->
            <div class="space-y-2">
              <span class="font-serif font-bold text-sm text-stone-900 tracking-tight block">
                Komposisi Bunga & Daun:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {product.flowerComposition.map((stem) => (
                  <span class="inline-block text-xs bg-stone-50 text-stone-800 px-3 py-1 rounded-lg border border-stone-200 font-medium">
                    ✓ {stem}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Direct Order Action Box (Solid Soft Green CTA) -->
          <div class="pt-4 border-t border-stone-100 space-y-3">
            <a
              href={waOrderUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-softGreen-800 hover:bg-softGreen-700 text-white font-bold text-sm shadow-md hover:shadow-xl transition-all active:scale-[0.99] border-2 border-softGreen-900"
            >
              <svg class="w-5 h-5 fill-white shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.979-.276-.1-.476-.15-.677.15-.201.301-.778.979-.953 1.18-.175.201-.351.226-.652.075-.301-.15-1.27-.468-2.42-1.493-.895-.798-1.5-1.784-1.675-2.085-.175-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.15-.175.201-.301.301-.501.101-.201.05-.377-.025-.527-.075-.15-.677-1.631-.928-2.233-.244-.587-.492-.507-.677-.517-.175-.009-.376-.011-.577-.011s-.527.075-.803.377c-.276.301-1.053 1.029-1.053 2.509 0 1.48 1.079 2.909 1.229 3.109.15.201 2.123 3.242 5.143 4.547.718.311 1.279.497 1.716.636.721.23 1.377.197 1.896.12.578-.087 1.78-.728 2.031-1.431.251-.703.251-1.305.176-1.431-.075-.126-.276-.201-.577-.351zM12.004 21.75c-1.75 0-3.465-.458-4.978-1.328l-.357-.205-3.699.97 1.002-3.606-.23-.377A9.708 9.708 0 0 1 2.25 12.004c0-5.377 4.377-9.754 9.754-9.754 2.606 0 5.056 1.015 6.899 2.858a9.697 9.697 0 0 1 2.858 6.896c0 5.38-4.377 9.754-9.757 9.754zm0-17.508c-4.275 0-7.754 3.479-7.754 7.758 0 1.365.357 2.698 1.034 3.873l.161.279-.611 2.203 2.261-.593.271.161a7.71 7.71 0 0 0 3.888 1.078c4.277 0 7.757-3.48 7.757-7.758 0-2.072-.807-4.021-2.273-5.487a7.71 7.71 0 0 0-5.488-2.274z"/>
              </svg>
              <span>Pesan Sekarang via WhatsApp</span>
            </a>

            <p class="text-center text-[11px] text-stone-500 font-sans">
              Format pemesanan otomatis terisi dengan kode {product.code} saat tombol ditekan.
            </p>
          </div>
        </div>
      </div>

      <!-- Related Bouquets Section: 4 Columns on Desktop (max-w-7xl) -->
      {relatedProducts.length > 0 && (
        <section class="mt-14 space-y-6">
          <div class="flex items-center justify-between border-b border-stone-200 pb-3">
            <h2 class="font-serif text-xl sm:text-2xl font-bold text-stone-900">
              Koleksi Serupa ({product.categoryLabel})
            </h2>
            <a href="/#katalog" class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-softGreen-800 hover:text-softGreen-900 transition-colors">
              <span>Lihat Semua</span>
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {relatedProducts.map((rel) => (
              <a
                href={`/koleksi/${rel.slug}`}
                class="group bg-white rounded-2xl border border-stone-200 overflow-hidden hover:shadow-lg transition-all"
              >
                <div class="aspect-[4/5] bg-stone-100 overflow-hidden">
                  {rel.imageUrl && (
                    <img
                      src={optimizeImageUrl(rel.imageUrl, 400, 75)}
                      alt={rel.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  )}
                </div>
                <div class="p-4 space-y-1.5">
                  <span class={`font-sans text-[10px] uppercase tracking-wider font-semibold px-2 py-0.5 rounded-md border inline-block ${getCategoryBadgeClasses(rel.category)}`}>
                    {rel.code}
                  </span>
                  <h3 class="font-serif text-sm font-bold text-stone-900 line-clamp-1 group-hover:text-softGreen-800 transition-colors">
                    {rel.title}
                  </h3>
                  <p class="font-serif text-sm font-bold text-stone-900">
                    {rel.priceDisplay}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>

    <StoreFooter studio={studio} />
    <GooeyNavMenu client:idle studio={studio} currentPath="/koleksi" />
  </div>
</BaseLayout>
