---
import '../index.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  jsonLd?: string;
}

const {
  title = "Pearl Store Flowers — Luxury Floral & Hand Bouquet Atelier",
  description = "Katalog resmi Pearl Store Flowers (@pearl.storeflowers): Buket bunga tangan pengantin (bridal), lamaran, wisuda & bunga abadi kustom di Slawi, Tegal & Brebes. Pesan langsung via WhatsApp.",
  ogImage = "https://images.unsplash.com/photo-1561181286-d3fee7d55364?auto=format&fit=crop&w=1200&q=80",
  ogType = "website",
  canonicalUrl = Astro.url.href,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Pearl Store Flowers" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pearlflower64" />
    <meta name="twitter:creator" content="@pearlflower64" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- PWA & Mobile Icons -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#183324" />
    <!-- Favicon & Mobile Touch Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/jpeg" href="/images/pearl_profile_avatar.jpg" />
    <link rel="apple-touch-icon" href="/images/pearl_profile_avatar.jpg" />

    <!-- Typography Fonts: Classical Serif & Modern Humanist Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Ultra-Lightweight, 120 FPS GPU-Accelerated View Transitions -->
    <style is:inline>
      svg { max-width: 100%; }
      img { max-width: 100%; height: auto; }

      /* Micro-Transition: Zero GPU Raster Thrashing, Instant 140ms Native Snap */
      ::view-transition-old(root) {
        animation: atelier-fade-out 140ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }
      ::view-transition-new(root) {
        animation: atelier-fade-in 140ms cubic-bezier(0.16, 1, 0.3, 1) both;
      }

      @keyframes atelier-fade-out {
        from { opacity: 1; transform: scale(1); }
        to { opacity: 0; transform: scale(0.998); }
      }
      @keyframes atelier-fade-in {
        from { opacity: 0; transform: scale(1.002); }
        to { opacity: 1; transform: scale(1); }
      }
    </style>

    <ViewTransitions />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body class="bg-atelier-bg text-atelier-text antialiased font-sans selection:bg-stone-900 selection:text-white min-h-screen flex flex-col">
    <slot />

    <!-- Lean, Non-Blocking Core Route Preloader -->
    <script>
      const coreRoutes = ['/', '/koleksi', '/panduan', '/tentang'];

      function preloadCoreRoutes() {
        const current = window.location.pathname.replace(/\/$/, '') || '/';
        const targets = coreRoutes.filter((r) => r !== current);

        targets.forEach((path) => {
          const existing = document.querySelector(`link[rel="prefetch"][href="${path}"]`);
          if (!existing) {
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = path;
            link.as = 'document';
            document.head.appendChild(link);
          }
        });
      }

      // Safe idle schedule without stealing main-thread rendering bandwidth
      if (typeof window !== 'undefined') {
        const scheduleIdle = () => {
          if ('requestIdleCallback' in window) {
            (window as any).requestIdleCallback(preloadCoreRoutes, { timeout: 2000 });
          } else {
            setTimeout(preloadCoreRoutes, 800);
          }
        };

        document.addEventListener('astro:page-load', scheduleIdle, { once: true });
      }
    </script>
</html>

