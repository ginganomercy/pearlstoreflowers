<script>
  function setupLookbookCarousel() {
    const track = document.getElementById('lookbook-track');
    const tabFlower = document.getElementById('tab-sheet-flower');
    const tabCustom = document.getElementById('tab-sheet-custom');
    const btnPrev = document.getElementById('btn-lookbook-prev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('btn-lookbook-next') as HTMLButtonElement | null;
    const slideFlower = document.getElementById('slide-sheet-flower');
    const slideCustom = document.getElementById('slide-sheet-custom');
    const pageIndicator = document.getElementById('lookbook-page-indicator');

    if (!track || !tabFlower || !tabCustom || !slideFlower || !slideCustom) return;

    const activeTabClass = 'px-3 sm:px-3.5 py-1.5 rounded-xl text-xs font-sans font-bold transition-all bg-white text-stone-900 shadow-2xs border border-stone-200';
    const inactiveTabClass = 'px-3 sm:px-3.5 py-1.5 rounded-xl text-xs font-sans font-bold transition-all text-stone-600 hover:text-stone-900 border border-transparent';

    let currentIndex = 0;

    function updateActiveState(index: number) {
      currentIndex = index;
      if (index === 0) {
        tabFlower.className = activeTabClass;
        tabCustom.className = inactiveTabClass;
        if (btnPrev) btnPrev.disabled = true;
        if (btnNext) btnNext.disabled = false;
        if (pageIndicator) pageIndicator.textContent = '1 / 2';
      } else {
        tabCustom.className = activeTabClass;
        tabFlower.className = inactiveTabClass;
        if (btnPrev) btnPrev.disabled = false;
        if (btnNext) btnNext.disabled = true;
        if (pageIndicator) pageIndicator.textContent = '2 / 2';
      }
    }

    function scrollToIndex(index: number) {
      if (index === 0) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        const targetPos = slideCustom.offsetLeft - track.offsetLeft;
        track.scrollTo({ left: targetPos > 0 ? targetPos : track.offsetWidth, behavior: 'smooth' });
      }
      updateActiveState(index);
    }

    // Tab Clicks
    tabFlower.addEventListener('click', () => scrollToIndex(0));
    tabCustom.addEventListener('click', () => scrollToIndex(1));

    // Arrow Button Clicks
    if (btnPrev) {
      btnPrev.addEventListener('click', () => scrollToIndex(0));
    }
    if (btnNext) {
      btnNext.addEventListener('click', () => scrollToIndex(1));
    }

    // Synchronize tab highlights on swipe
    let scrollRafId: number | null = null;
    track.addEventListener('scroll', () => {
      if (scrollRafId !== null) return;
      scrollRafId = requestAnimationFrame(() => {
        scrollRafId = null;
        const slideWidth = slideFlower.offsetWidth || track.offsetWidth;
        const idx = Math.min(1, Math.max(0, Math.round(track.scrollLeft / (slideWidth * 0.6))));
        if (idx !== currentIndex) {
          updateActiveState(idx);
        }
      });
    }, { passive: true });

    // Touch & Mouse Interaction Engines (Separated for 120 FPS Native Mobile Compositor)
    let isMouseDown = false;
    let startMouseX = 0;
    let scrollStart = 0;
    let isSwiping = false;

    // Track touch start position to disambiguate tap vs drag on images/links
    let touchStartX = 0;
    let touchStartY = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length > 0) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isSwiping = false;
      }
    }, { passive: true });

    track.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const dx = Math.abs(e.touches[0].clientX - touchStartX);
        const dy = Math.abs(e.touches[0].clientY - touchStartY);
        if (dx > 6) {
          isSwiping = true;
        }
      }
    }, { passive: true });

    // Desktop Mouse Drag Only
    track.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      const target = e.target as HTMLElement | null;
      if (target?.closest('button, a')) return;
      isMouseDown = true;
      isSwiping = false;
      startMouseX = e.pageX;
      scrollStart = track.scrollLeft;
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isMouseDown || e.pointerType !== 'mouse') return;
      const dx = e.pageX - startMouseX;
      if (Math.abs(dx) > 6) {
        isSwiping = true;
        track.scrollLeft = scrollStart - dx;
      }
    });

    const endMouseDrag = (e: PointerEvent) => {
      if (e.pointerType === 'mouse' && isMouseDown) {
        isMouseDown = false;
      }
    };

    window.addEventListener('pointerup', endMouseDrag);
    window.addEventListener('pointercancel', endMouseDrag);

    // Prevent accidental zoom/image open if dragged or swiped
    const sheetImages = track.querySelectorAll('img');
    sheetImages.forEach((img) => {
      img.addEventListener('click', (e: MouseEvent) => {
        if (isSwiping) {
          e.preventDefault();
          e.stopPropagation();
          isSwiping = false;
          return;
        }
        const src = img.getAttribute('src');
        if (src) {
          window.open(src, '_blank');
        }
      });
    });

    // Capture-phase Click Blocker: prevents accidental link navigation when swiping/dragging
    track.addEventListener('click', (e: MouseEvent) => {
      if (isSwiping) {
        e.preventDefault();
        e.stopPropagation();
        isSwiping = false;
      }
    }, true);

    // Initial state
    updateActiveState(0);
  }

  setupLookbookCarousel();
  document.addEventListener('astro:page-load', setupLookbookCarousel);
</script>

