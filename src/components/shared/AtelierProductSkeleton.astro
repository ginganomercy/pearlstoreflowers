---
import type { FlowerProduct } from '../../domain/types';

interface Props {
  product: FlowerProduct;
  variant?: 'card' | 'modal' | 'hero';
}

const { product, variant = 'card' } = Astro.props;

const getCategoryTheme = (category: string) => {
  switch (category) {
    case 'Engagement':
      return {
        bg: 'bg-[#F2F7F3]',
        border: 'border-softGreen-300',
        badgeBg: 'bg-softGreen-200 text-softGreen-950 border-softGreen-400',
      };
    case 'Graduation':
      return {
        bg: 'bg-[#F2F5FB]',
        border: 'border-softBlue-300',
        badgeBg: 'bg-softBlue-200 text-softBlue-950 border-softBlue-400',
      };
    case 'Wedding':
      return {
        bg: 'bg-[#FDF2F5]',
        border: 'border-softPink-300',
        badgeBg: 'bg-softPink-200 text-softPink-950 border-softPink-400',
      };
    default:
      return {
        bg: 'bg-[#FAF6EC]',
        border: 'border-softYellow-300',
        badgeBg: 'bg-softYellow-200 text-softYellow-950 border-softYellow-400',
      };
  }
};

const theme = getCategoryTheme(product.category);
const flowersSummary = product.flowerComposition?.slice(0, 2).join(' • ') || 'Kuntum Segar Pilihan Atelier';
---

<div
  class={`relative w-full h-full overflow-hidden select-none flex flex-col items-center justify-between p-4 sm:p-6 ${theme.bg} border ${theme.border} transition-all duration-300 hover:scale-[1.005]`}
>
  <!-- Animated Luxury Shimmer Beam -->
  <div class="atelier-shimmer-beam"></div>

  <!-- Subtle Vintage Border Pattern -->
  <div class="absolute inset-2.5 border border-black/5 rounded-xl pointer-events-none"></div>

  <!-- Top: Atelier Signature Hallmark Pill -->
  <div class="relative z-10 flex items-center justify-center w-full pt-1">
    <span
      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-sans text-[10px] sm:text-xs font-extrabold uppercase tracking-widest shadow-2xs border bg-white/95 text-stone-800 border-stone-200"
    >
      <span class="text-amber-600 text-xs">✦</span>
      <span>Kurasi Atelier 2024</span>
      <span class="text-amber-600 text-xs">✦</span>
    </span>
  </div>

  <!-- Center: Pearl Store Flowers Medallion & Brand Identity -->
  <div class="relative z-10 flex flex-col items-center text-center my-auto py-3">
    <!-- Outer Medallion Halo with Gold Accent Ring -->
    <div
      class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full p-1 bg-white shadow-md border-2 border-amber-300/80 mb-3 flex items-center justify-center"
    >
      <img
        src="/images/pearl_profile_avatar.jpg"
        alt="Pearl Store Flowers Official Avatar"
        width="80"
        height="80"
        class="w-full h-full rounded-full object-cover border border-stone-200"
        loading="eager"
      />
      <!-- Little Gold Star Sparkle -->
      <span class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-amber-400 text-stone-900 text-[10px] font-bold flex items-center justify-center shadow-xs">
        ✦
      </span>
    </div>

    <h4 class="font-serif font-bold text-sm sm:text-lg text-stone-900 tracking-tight leading-tight">
      Pearl Store Flowers
    </h4>
    <p class="font-sans text-[10px] sm:text-xs text-stone-500 uppercase tracking-widest font-bold mt-1">
      Foto Dalam Kurasi Studio
    </p>

    <!-- Flower Composition Micro-Pill -->
    <div class="mt-3 px-3 py-1.5 rounded-full bg-white/95 border border-stone-200 shadow-2xs max-w-[90%]">
      <p class="font-sans text-[10px] sm:text-xs text-stone-700 font-medium truncate">
        💐 {flowersSummary}
      </p>
    </div>
  </div>

  <!-- Bottom: Order Availability Reassurance -->
  <div class="relative z-10 w-full text-center pb-1">
    <span class="inline-block text-[10px] sm:text-xs font-sans font-semibold text-softGreen-900 bg-softGreen-100/90 border border-softGreen-300 px-3 py-1 rounded-full shadow-2xs">
      ✓ Rangkaian Siap Dipesan Langsung
    </span>
  </div>
</div>

<style>
  .atelier-shimmer-beam {
    position: absolute;
    top: 0;
    left: -150%;
    width: 150%;
    height: 100%;
    background: linear-gradient(
      115deg,
      transparent 20%,
      rgba(255, 255, 255, 0.45) 50%,
      transparent 80%
    );
    animation: atelier-shimmer 3.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    pointer-events: none;
    z-index: 5;
  }

  @keyframes atelier-shimmer {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(200%);
    }
  }
</style>

