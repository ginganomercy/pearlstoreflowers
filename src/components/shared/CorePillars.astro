---
// Atelier Core Value Pillars: 4 Rich Solid Soft Colors & Thick Bold Vector Icons (Zero Gradient Policy)
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-3.5">
  <!-- Pillar 1: Rich Soft Green (100% Solid Opacity) -->
  <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-softGreen-200 border-2 border-softGreen-400 hover:bg-softGreen-300 transition-all shadow-2xs">
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white border-2 border-softGreen-400 text-softGreen-900 flex items-center justify-center shadow-xs shrink-0">
      <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>
    <div class="text-[11px] leading-tight">
      <p class="font-bold text-softGreen-950 font-serif text-xs">Kurasi Bunga Segar</p>
      <p class="text-softGreen-900 font-semibold hidden sm:block">Kuntum pilihan mekar sempurna</p>
      <p class="text-softGreen-900 font-semibold sm:hidden">Mekar sempurna</p>
    </div>
  </div>

  <!-- Pillar 2: Rich Soft Pink (100% Solid Opacity) -->
  <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-softPink-200 border-2 border-softPink-400 hover:bg-softPink-300 transition-all shadow-2xs">
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white border-2 border-softPink-400 text-softPink-900 flex items-center justify-center shadow-xs shrink-0">
      <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    </div>
    <div class="text-[11px] leading-tight">
      <p class="font-bold text-softPink-950 font-serif text-xs">Kartu Bersegel Lilin</p>
      <p class="text-softPink-900 font-semibold hidden sm:block">Surat ucapan elegan gratis</p>
      <p class="text-softPink-900 font-semibold sm:hidden">Elegan & gratis</p>
    </div>
  </div>

  <!-- Pillar 3: Rich Soft Blue (100% Solid Opacity) -->
  <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-softBlue-200 border-2 border-softBlue-400 hover:bg-softBlue-300 transition-all shadow-2xs">
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white border-2 border-softBlue-400 text-softBlue-900 flex items-center justify-center shadow-xs shrink-0">
      <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
    </div>
    <div class="text-[11px] leading-tight">
      <p class="font-bold text-softBlue-950 font-serif text-xs">Layanan Sameday</p>
      <p class="text-softBlue-900 font-semibold hidden sm:block">Slot instan harian tersedia</p>
      <p class="text-softBlue-900 font-semibold sm:hidden">Slawi & Tegal</p>
    </div>
  </div>

  <!-- Pillar 4: Rich Soft Yellow (100% Solid Opacity) -->
  <div class="flex items-center gap-3 p-3.5 sm:p-4 rounded-2xl bg-softYellow-200 border-2 border-softYellow-400 hover:bg-softYellow-300 transition-all shadow-2xs">
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white border-2 border-softYellow-400 text-softYellow-900 flex items-center justify-center shadow-xs shrink-0">
      <svg class="w-4.5 h-4.5 sm:w-5 sm:h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="m7.5 4.27 9 5.15"/>
        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
        <path d="m3.3 7 8.7 5 8.7-5"/>
        <path d="M12 22V12"/>
      </svg>
    </div>
    <div class="text-[11px] leading-tight">
      <p class="font-bold text-softYellow-950 font-serif text-xs">Proteksi Buket Aman</p>
      <p class="text-softYellow-900 font-semibold hidden sm:block">Hardbox kokoh menjaga bentuk</p>
      <p class="text-softYellow-900 font-semibold sm:hidden">Box kokoh aman</p>
    </div>
  </div>
</div>

