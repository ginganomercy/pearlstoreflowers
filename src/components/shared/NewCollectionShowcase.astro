---
interface CollectionTheme {
  id: string;
  name: string;
  colorName: string;
  tag: string;
  bannerImage: string;
  paletteBg: string;
  paletteBorder: string;
  badgeBg: string;
  flowers: string[];
}

const collections: CollectionTheme[] = [
  {
    id: 'sage-green',
    name: 'Sage Mint & Forest',
    colorName: 'Sage Green',
    tag: 'Edition 01',
    bannerImage: '/images/banners/banner-sage-green.png',
    paletteBg: 'bg-softGreen-100',
    paletteBorder: 'border-softGreen-300',
    badgeBg: 'bg-softGreen-200 text-softGreen-900 border-softGreen-400',
    flowers: ['Abella Pastel Duo', 'Geny Red Rose', 'Forest Enchanted']
  },
  {
    id: 'mauve',
    name: 'Mauve & Lavender',
    colorName: 'Mauve Mist',
    tag: 'Edition 02',
    bannerImage: '/images/banners/banner-mauve.png',
    paletteBg: 'bg-[#F7F2F6]',
    paletteBorder: 'border-softPink-300',
    badgeBg: 'bg-softPink-200 text-softPink-900 border-softPink-400',
    flowers: ['Alena Daisy', 'Joulen Mauve', 'Krysan Sun']
  },
  {
    id: 'camel-gold',
    name: 'Kraft & Vintage Burlap',
    colorName: 'Camel Kraft',
    tag: 'Edition 03',
    bannerImage: '/images/banners/banner-camel-gold.png',
    paletteBg: 'bg-softYellow-100',
    paletteBorder: 'border-softYellow-300',
    badgeBg: 'bg-softYellow-200 text-softYellow-900 border-softYellow-400',
    flowers: ['Gerberrash', 'Casablanka Lily', 'Oggliy Rouses']
  },
  {
    id: 'lilac-violet',
    name: 'Frosted Violet & White',
    colorName: 'Frosted Violet',
    tag: 'Edition 04',
    bannerImage: '/images/banners/banner-lilac-violet.png',
    paletteBg: 'bg-softBlue-100',
    paletteBorder: 'border-softBlue-300',
    badgeBg: 'bg-softBlue-200 text-softBlue-900 border-softBlue-400',
    flowers: ['Merrys Tube', 'Ayunda Purple', 'Shakyra White']
  },
  {
    id: 'ballet-pink',
    name: 'Ballet Pink & Stargazer',
    colorName: 'Ballet Pink',
    tag: 'Edition 05',
    bannerImage: '/images/banners/banner-ballet-pink.png',
    paletteBg: 'bg-softPink-100',
    paletteBorder: 'border-softPink-300',
    badgeBg: 'bg-softPink-200 text-softPink-900 border-softPink-400',
    flowers: ['Pinkly Thumbelina', 'Soully Meadow', 'Mounty Sunflower']
  },
  {
    id: 'sunflower-yellow',
    name: 'Sunshine Gold & Origami',
    colorName: 'Golden Sun',
    tag: 'Edition 06',
    bannerImage: '/images/banners/banner-sunflower-yellow.png',
    paletteBg: 'bg-softYellow-100',
    paletteBorder: 'border-softYellow-300',
    badgeBg: 'bg-softYellow-200 text-softYellow-900 border-softYellow-400',
    flowers: ['Rouse Mouwien', 'Suny Pointy', 'Flowerty Studio']
  },
  {
    id: 'onyx-noir',
    name: 'Onyx Noir & Velvet Rose',
    colorName: 'Noir Velvet',
    tag: 'Edition 07',
    bannerImage: '/images/banners/banner-onyx-noir.png',
    paletteBg: 'bg-stone-100',
    paletteBorder: 'border-stone-300',
    badgeBg: 'bg-stone-200 text-stone-900 border-stone-400',
    flowers: ['Talley Noir', 'Arrounyd 3D Dome', 'Maybelly Minimal']
  }
];
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-stone-200 pb-3">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-softGreen-200 border border-softGreen-400 text-softGreen-950 text-[10px] font-sans font-bold uppercase tracking-wider mb-1.5">
        <span>Koleksi Eksklusif 2024</span>
      </div>
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight">
        7 Tema Palet New Collection
      </h2>
      <p class="text-xs text-stone-600 font-sans mt-0.5 max-w-xl">
        Edisi editorial autentik dari studio Pearl Store Flowers — setiap palet merangkum 3 karya buket pilihan dengan harmoni warna & kuntum mekar sempurna.
      </p>
    </div>

    <a
      href="/koleksi"
      class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-softGreen-800 hover:text-softGreen-900 transition-colors shrink-0"
    >
      <span>Lihat Semua 21 Buket</span>
      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Horizontal Scrollable Showcase Track -->
  <div class="relative -mx-4 sm:mx-0 px-4 sm:px-0">
    <div
      class="flex gap-4 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory scrollbar-none"
      style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
    >
      {collections.map((col) => (
        <a
          href="/koleksi"
          class={`snap-start shrink-0 w-64 sm:w-72 rounded-2xl border-2 ${col.paletteBorder} ${col.paletteBg} p-3.5 flex flex-col justify-between shadow-2xs hover:shadow-lg transition-all duration-300 hover:-translate-y-1 group`}
        >
          <!-- Card Header & Badge -->
          <div class="flex items-center justify-between mb-2.5">
            <span class={`text-[10px] font-sans font-bold px-2 py-0.5 rounded-full border ${col.badgeBg}`}>
              {col.tag}
            </span>
            <span class="text-[11px] font-sans font-semibold text-stone-600">
              {col.colorName}
            </span>
          </div>

          <!-- Editorial Banner Preview & Stems -->
          <div class="flex items-center gap-3 my-1">
            <!-- Vertical Banner Strip -->
            <div class="w-16 h-48 sm:h-52 rounded-xl overflow-hidden border border-stone-300 bg-white shadow-2xs shrink-0 flex items-center justify-center">
              <img
                src={col.bannerImage}
                alt={`New Collection Banner - ${col.name}`}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>

            <!-- Stems in this Collection -->
            <div class="flex-1 space-y-2">
              <span class="text-[9px] uppercase tracking-wider text-stone-500 font-bold block">
                3 Rangkaian Terpilih:
              </span>
              <ul class="space-y-1.5 text-xs font-sans text-stone-800">
                {col.flowers.map((fl) => (
                  <li class="flex items-center gap-1.5 leading-tight">
                    <span class="w-1.5 h-1.5 rounded-full bg-softGreen-800 shrink-0"></span>
                    <span class="font-medium text-[11px] line-clamp-1">{fl}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Card Footer CTA -->
          <div class="pt-2.5 mt-2 border-t border-stone-200/80 flex items-center justify-between">
            <span class="font-serif text-xs font-bold text-stone-900 group-hover:text-softGreen-800 transition-colors">
              {col.name}
            </span>
            <span class="inline-flex items-center gap-1 text-[11px] font-sans font-bold text-softGreen-800 group-hover:translate-x-0.5 transition-transform">
              <span>Buka</span>
              <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

