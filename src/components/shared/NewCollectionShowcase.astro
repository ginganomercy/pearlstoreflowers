---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
  <!-- Section Header & Navigation Controls -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-stone-200 pb-3">
    <div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-softGreen-200 border border-softGreen-400 text-softGreen-950 text-[10px] font-sans font-bold uppercase tracking-wider mb-1.5">
        <span>Koleksi Eksklusif Studio</span>
      </div>
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 tracking-tight">
        7 Tema New Collection
      </h2>
      <p class="text-xs text-stone-600 font-sans mt-0.5 max-w-xl">
        Koleksi autentik studio Pearl Store Flowers — setiap edisi merangkum 3 karya buket pilihan dengan harmoni palet warna mekar sempurna.
      </p>
    </div>

    <!-- Desktop Navigation Controls & All Link -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="/koleksi"
        class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-softGreen-800 hover:text-softGreen-900 transition-colors"
      >
        <span>Lihat Semua 21 Buket</span>
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>

      <!-- Prev & Next Arrow Controls for Desktop -->
      <div class="hidden sm:flex items-center gap-1.5 pl-2 border-l border-stone-200">
        <button
          type="button"
          id="btn-showcase-prev"
          class="w-8 h-8 rounded-xl bg-white border border-stone-300 hover:border-softGreen-500 text-stone-700 hover:text-softGreen-900 flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-2xs"
          aria-label="Geser ke kiri"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <button
          type="button"
          id="btn-showcase-next"
          class="w-8 h-8 rounded-xl bg-white border border-stone-300 hover:border-softGreen-500 text-stone-700 hover:text-softGreen-900 flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-2xs"
          aria-label="Geser ke kanan"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Horizontal Rail without Native Scrollbar -->
  <div class="relative">
    <div
      id="new-collection-track"
      class="flex gap-4 overflow-x-auto pb-4 pt-1 snap-x snap-mandatory no-scrollbar"
      style="scroll-behavior: smooth; -webkit-overflow-scrolling: touch;"
    >
      {collections.map((col) => (
        <article
          class={`snap-start shrink-0 w-[310px] sm:w-[350px] rounded-2xl border-2 ${col.paletteBorder} ${col.paletteBg} p-3.5 flex flex-col justify-between shadow-2xs hover:shadow-lg transition-all duration-300 hover:-translate-y-1`}
        >
          <!-- Card Header: Edition Tag & Theme Name -->
          <div class="flex items-center justify-between pb-2 border-b border-stone-200/70 mb-2.5">
            <span class={`text-[10px] font-sans font-bold px-2.5 py-0.5 rounded-full border ${col.badgeBg}`}>
              {col.tag}
            </span>
            <span class="text-xs font-serif font-bold text-stone-800">
              {col.name}
            </span>
          </div>

          <!-- Card Body: Unclipped Vertical Banner Spine + 3 Flower Products -->
          <div class="flex items-center gap-3">
            <!-- Left: Authentic Vertical Banner (Preserved 1:5.07 Ratio, 100% Unclipped) -->
            <div class="w-13 sm:w-14 h-[208px] rounded-xl overflow-hidden border border-stone-300/80 bg-white shadow-2xs shrink-0 flex items-center justify-center p-0.5">
              <img
                src={col.bannerImage}
                alt={`Banner ${col.name}`}
                loading="lazy"
                class="w-full h-full object-contain"
              />
            </div>

            <!-- Right: 3 Real Flower Bouquets -->
            <div class="flex-1 space-y-2">
              <span class="text-[9px] uppercase tracking-wider text-stone-500 font-bold block">
                3 Rangkaian Terpilih:
              </span>
              <div class="space-y-1.5">
                {col.products.map((item) => (
                  <a
                    href={`/koleksi/${item.slug}`}
                    class="flex items-center gap-2 p-1.5 rounded-xl bg-white/70 hover:bg-white border border-stone-200/60 shadow-2xs hover:shadow transition-all group/item"
                    title={`Lihat detail ${item.name}`}
                  >
                    <!-- Flower Photo Thumbnail -->
                    <div class="w-10 h-10 rounded-lg overflow-hidden bg-stone-100 border border-stone-200 shrink-0">
                      <img
                        src={item.image}
                        alt={item.name}
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-300 group-hover/item:scale-110"
                      />
                    </div>

                    <!-- Flower Info -->
                    <div class="flex-1 min-w-0">
                      <h4 class="font-serif text-[11px] sm:text-xs font-bold text-stone-900 truncate group-hover/item:text-softGreen-800 transition-colors">
                        {item.name}
                      </h4>
                      <span class="font-sans text-[10px] font-bold text-softGreen-900 block leading-tight">
                        {item.priceDisplay}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Card Footer: Link to Collection -->
          <div class="pt-2.5 mt-2.5 border-t border-stone-200/70 flex items-center justify-between">
            <span class="text-[10px] font-sans text-stone-500 font-medium">
              3 Buket Autentik
            </span>
            <a
              href="/koleksi"
              class="inline-flex items-center gap-1 text-[11px] font-sans font-bold text-softGreen-800 hover:text-softGreen-950 transition-colors"
            >
              <span>Jelajahi Tema</span>
              <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  function setupShowcaseControls() {
    const track = document.getElementById('new-collection-track');
    const prevBtn = document.getElementById('btn-showcase-prev');
    const nextBtn = document.getElementById('btn-showcase-next');

    if (!track || !prevBtn || !nextBtn) return;

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -340, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: 340, behavior: 'smooth' });
    });
  }

  // Setup on initial load & Astro ViewTransitions
  setupShowcaseControls();
  document.addEventListener('astro:page-load', setupShowcaseControls);
</script>
