<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
  <!-- Section Header & Navigation Controls -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-stone-200 pb-3">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-softGreen-200 border border-softGreen-400 text-softGreen-950 text-[10px] sm:text-xs font-sans font-bold uppercase tracking-wider mb-2">
        <span class="text-xs">✦</span>
        <span>Koleksi Eksklusif Studio</span>
      </div>

      <!-- Atelier Decoupled Numeral & Title: 7 Tema Spektrum New Collection -->
      <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap">
        <span class="inline-flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10 rounded-xl sm:rounded-2xl bg-stone-900 text-white font-serif font-black text-base sm:text-xl shadow-xs border border-stone-700 shrink-0">
          7
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-extrabold text-stone-900 tracking-normal leading-tight">
          Tema Spektrum <span class="italic font-serif font-semibold text-botanical-800">New Collection</span>
        </h2>
      </div>

      <p class="text-xs sm:text-sm text-stone-600 font-sans mt-1.5 max-w-xl">
        Koleksi autentik studio Pearl Store Flowers — setiap edisi merangkum 3 karya buket pilihan dengan harmoni palet warna mekar sempurna.
      </p>
    </div>

    <!-- Desktop Navigation Controls & All Link -->
    <div class="flex items-center gap-3 shrink-0">
      <a
        href="/koleksi"
        class="inline-flex items-center gap-1.5 text-xs font-sans font-bold text-softGreen-800 hover:text-softGreen-900 transition-colors"
      >
        <span>Lihat Semua 37 Buket</span>
        <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>

      <!-- Prev & Next Arrow Controls for Mobile & Desktop -->
      <div class="flex items-center gap-1.5 pl-2 border-l border-stone-200">
        <button
          type="button"
          id="btn-showcase-prev"
          class="w-8 h-8 rounded-xl bg-white border border-stone-300 hover:border-softGreen-500 text-stone-700 hover:text-softGreen-900 flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-2xs"
          aria-label="Geser ke kiri"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <button
          type="button"
          id="btn-showcase-next"
          class="w-8 h-8 rounded-xl bg-white border border-stone-300 hover:border-softGreen-500 text-stone-700 hover:text-softGreen-900 flex items-center justify-center transition-all hover:scale-105 active:scale-95 shadow-2xs"
          aria-label="Geser ke kanan"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Horizontal Rail with Fluid Touch Physics -->
  <div class="relative group/showcase">
    <div
      id="new-collection-track"
      class="flex gap-3 sm:gap-4 overflow-x-auto pb-3 pt-1 snap-x snap-proximity no-scrollbar cursor-grab active:cursor-grabbing select-none"
      style="-webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; touch-action: pan-x pan-y;"
    >
      {collections.map((col) => (
        <article
          class={`group snap-start shrink-0 w-[84vw] max-w-[325px] sm:w-[350px] rounded-2xl border-2 ${col.paletteBorder} ${col.paletteBg} p-3.5 flex flex-col justify-between shadow-2xs hover:shadow-lg transition-all duration-300 hover:-translate-y-1 select-none`}
          style="touch-action: pan-x pan-y; -webkit-touch-callout: none;"
        >
          <!-- Card Header: Edition Tag & Theme Name -->
          <div class="flex items-center justify-between pb-2 border-b border-stone-200/70 mb-2.5">
            <span class={`text-[10px] font-sans font-bold px-2.5 py-0.5 rounded-full border ${col.badgeBg}`}>
              {col.tag}
            </span>
            <span class="text-xs font-serif font-bold text-stone-800">
              {col.name}
            </span>
          </div>

          <!-- Card Body: Razor-Sharp Vector Editorial Spine + 3 Flower Products -->
          <div class="flex items-center gap-3">
            <!-- Left: Razor-Sharp Vector Editorial Spine Ribbon (100% Crisp, Deep Pigment) -->
            <div
              class="w-11 sm:w-12 h-[208px] rounded-xl overflow-hidden shadow-xs shrink-0 flex flex-col items-center justify-between py-2.5 px-0.5 border border-black/10 select-none relative group/spine transition-transform duration-300 group-hover:scale-105"
              style={`background-color: ${col.colorHex}; touch-action: pan-x pan-y;`}
              title={`Edisi ${col.name} — New Collection`}
            >
              <!-- Subtle Inner Luxury Inset Line -->
              <div class="absolute inset-1 rounded-lg border border-white/20 pointer-events-none"></div>

              <!-- Top Studio Hallmark Star -->
              <span class="text-white/80 text-[10px] leading-none z-10">✦</span>

              <!-- Center: Bold Razor-Sharp Vector Typography -->
              <div class="flex-1 flex items-center justify-center z-10">
                <span
                  class="font-serif font-black tracking-[0.32em] text-[10px] sm:text-[11px] text-white uppercase drop-shadow-xs"
                  style="writing-mode: vertical-rl; transform: rotate(180deg);"
                >
                  NEW COLLECTION
                </span>
              </div>

              <!-- Bottom: Edition Tag -->
              <span class="text-[9px] font-mono font-bold tracking-wider text-white/90 uppercase z-10">
                {col.tag.replace('Edition ', 'ED.')}
              </span>
            </div>

            <!-- Right: 3 Real Flower Bouquets (Full Width, Swipeable with Tap-Guard) -->
            <div class="flex-1 space-y-2 select-none" style="touch-action: pan-x pan-y;">
              <span class="text-[9px] uppercase tracking-wider text-stone-500 font-bold block select-none">
                3 Rangkaian Terpilih:
              </span>
              <div class="space-y-1.5" style="touch-action: pan-x pan-y;">
                {col.products.map((item) => (
                  <a
                    href={`/koleksi/${item.slug}`}
                    class="flex items-center gap-2 p-1.5 rounded-xl bg-white/70 hover:bg-white border border-stone-200/60 shadow-2xs hover:shadow transition-all group/item select-none"
                    style="touch-action: pan-x pan-y; -webkit-touch-callout: none;"
                    title={`Lihat detail ${item.name}`}
                  >
                    <!-- Flower Photo Thumbnail -->
                    <div class="w-10 h-10 rounded-lg overflow-hidden bg-stone-100 border border-stone-200 shrink-0 pointer-events-none select-none flex items-center justify-center">
                      {item.image ? (
                        <img
                          src={item.image}
                          alt={item.name}
                          loading="lazy"
                          draggable="false"
                          class="w-full h-full object-cover transition-transform duration-300 group-hover/item:scale-110 pointer-events-none select-none"
                          style="-webkit-user-drag: none;"
                        />
                      ) : (
                        <div class="w-full h-full bg-stone-50 flex items-center justify-center p-1 relative">
                          <img
                            src="/images/pearl_profile_avatar.jpg"
                            alt="Pearl Store Flowers Logo"
                            class="w-7 h-7 rounded-full object-cover border border-amber-300 shadow-2xs"
                          />
                          <span class="absolute -top-0.5 -right-0.5 text-[8px] text-amber-500 font-bold">✦</span>
                        </div>
                      )}
                    </div>

                    <!-- Flower Info -->
                    <div class="flex-1 min-w-0 select-none pointer-events-none">
                      <h4 class="font-serif text-[11px] sm:text-xs font-bold text-stone-900 truncate group-hover/item:text-softGreen-800 transition-colors">
                        {item.name}
                      </h4>
                      <span class="font-sans text-[10px] font-bold text-softGreen-900 block leading-tight">
                        {item.priceDisplay}
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <!-- Card Footer: Link to Collection -->
          <div class="pt-2.5 mt-2.5 border-t border-stone-200/70 flex items-center justify-between select-none" style="touch-action: pan-x pan-y;">
            <span class="text-[10px] font-sans text-stone-500 font-medium select-none">
              3 Buket Autentik
            </span>
            <a
              href="/koleksi"
              class="inline-flex items-center gap-1 text-[11px] font-sans font-bold text-softGreen-800 hover:text-softGreen-950 transition-colors select-none"
              style="touch-action: pan-x pan-y;"
            >
              <span>Jelajahi Tema</span>
              <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- 7 Interactive Edition Pagination Dots (Mobile & Desktop) -->
    <div class="flex items-center justify-center gap-1.5 pt-2 pb-1" id="showcase-dots" role="tablist" aria-label="Pilih Edisi Tema">
      {collections.map((col, idx) => (
        <button
          type="button"
          class={`dot-indicator h-2 rounded-full transition-all duration-300 focus:outline-none ${idx === 0 ? 'w-6 bg-stone-900 shadow-2xs' : 'w-2 bg-stone-300 hover:bg-stone-400'}`}
          data-index={idx}
          aria-label={`Lihat Edisi ${idx + 1}: ${col.name}`}
          title={`Edisi ${idx + 1}: ${col.name}`}
        />
      ))}
    </div>
  </div>
</section>

<script>
  function setupShowcaseControls() {
    const track = document.getElementById('new-collection-track');
    const prevBtn = document.getElementById('btn-showcase-prev');
    const nextBtn = document.getElementById('btn-showcase-next');
    const dots = document.querySelectorAll('#showcase-dots .dot-indicator');

    if (!track) return;

    // Helper: calculate scroll delta per step based on current card width + gap
    function getScrollStep(): number {
      const firstCard = track?.querySelector('article') as HTMLElement | null;
      if (firstCard) {
        return firstCard.offsetWidth + 16; // card width + gap
      }
      return 320;
    }

    // Button controls with smooth animation
    if (prevBtn) {
      prevBtn.onclick = () => {
        track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
      };
    }

    if (nextBtn) {
      nextBtn.onclick = () => {
        track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
      };
    }

    // Dot indicators click
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index') || '0');
        const step = getScrollStep();
        track.scrollTo({ left: idx * step, behavior: 'smooth' });
      });
    });

    // Update active dot on scroll with requestAnimationFrame
    let isTicking = false;
    track.addEventListener('scroll', () => {
      if (!isTicking) {
        window.requestAnimationFrame(() => {
          const step = getScrollStep();
          const activeIndex = Math.min(
            dots.length - 1,
            Math.max(0, Math.round(track.scrollLeft / step))
          );

          dots.forEach((dot, idx) => {
            if (idx === activeIndex) {
              dot.classList.remove('w-2', 'bg-stone-300');
              dot.classList.add('w-6', 'bg-stone-900', 'shadow-2xs');
            } else {
              dot.classList.remove('w-6', 'bg-stone-900', 'shadow-2xs');
              dot.classList.add('w-2', 'bg-stone-300');
            }
          });

          isTicking = false;
        });
        isTicking = true;
      }
    }, { passive: true });

    // Pointer Drag Support EXCLUSIVELY for Mouse (Desktop)
    // On Touchscreens (e.pointerType === 'touch'), native browser compositor runs 120 FPS hardware inertia!
    let isMouseDown = false;
    let startMouseX = 0;
    let startScrollLeft = 0;
    let isSwiping = false;

    // Track touch start position to disambiguate tap vs drag on links (Mobile Touch)
    let touchStartX = 0;
    let touchStartY = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length > 0) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        isSwiping = false;
      }
    }, { passive: true });

    track.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const dx = Math.abs(e.touches[0].clientX - touchStartX);
        const dy = Math.abs(e.touches[0].clientY - touchStartY);
        if (dx > 6) {
          isSwiping = true;
        }
      }
    }, { passive: true });

    // Desktop Mouse Grab-to-Scroll Only
    track.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      isMouseDown = true;
      isSwiping = false;
      startMouseX = e.clientX;
      startScrollLeft = track.scrollLeft;
    });

    window.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isMouseDown || e.pointerType !== 'mouse') return;
      const dx = e.clientX - startMouseX;
      if (Math.abs(dx) > 6) {
        isSwiping = true;
        track.scrollLeft = startScrollLeft - dx;
      }
    });

    const endMouseDrag = (e: PointerEvent) => {
      if (e.pointerType === 'mouse' && isMouseDown) {
        isMouseDown = false;
      }
    };

    window.addEventListener('pointerup', endMouseDrag);
    window.addEventListener('pointercancel', endMouseDrag);

    // Capture-phase Click Blocker: prevents accidental link navigation when swiping/dragging
    track.addEventListener('click', (e: MouseEvent) => {
      if (isSwiping) {
        e.preventDefault();
        e.stopPropagation();
        isSwiping = false;
      }
    }, true);
  }

  // Setup on initial load & Astro ViewTransitions
  setupShowcaseControls();
  document.addEventListener('astro:page-load', setupShowcaseControls);
</script>
