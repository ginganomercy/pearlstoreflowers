---
import type { StudioInfo } from '../domain/types';
import { createWhatsAppConsultLink } from '../application/whatsapp';

interface Props {
  studio: StudioInfo;
}

const { studio } = Astro.props;
const consultWaUrl = createWhatsAppConsultLink(studio);
---

<footer class="w-full bg-white text-stone-700 border-t border-stone-200 mt-20 pt-14 pb-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- 4 Solid Soft Atelier Guarantee Pills (Rich Colors & Thick Bold Vector Icons) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-softPink-200 border-2 border-softPink-400 text-softPink-950 text-xs font-sans font-bold shadow-2xs">
        <svg class="w-4 h-4 text-softPink-900 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 7.5a4.5 4.5 0 1 1 4.5 4.5M12 7.5A4.5 4.5 0 1 0 7.5 12M12 7.5V9m-4.5 3a4.5 4.5 0 1 0 4.5 4.5M7.5 12H9m7.5 0a4.5 4.5 0 1 1-4.5 4.5m4.5-4.5H15m-3 4.5V15"/>
        </svg>
        <span>Spesialis Bridal & Wedding Slawi</span>
      </div>
      <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-softGreen-200 border-2 border-softGreen-400 text-softGreen-950 text-xs font-sans font-bold shadow-2xs">
        <svg class="w-4 h-4 text-softGreen-900 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
        </svg>
        <span>Tangkai Segar Tegal & Brebes Area</span>
      </div>
      <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-softBlue-200 border-2 border-softBlue-400 text-softBlue-950 text-xs font-sans font-bold shadow-2xs">
        <svg class="w-4 h-4 text-softBlue-900 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        <span>Respons Cepat WhatsApp Harian</span>
      </div>
      <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-softYellow-200 border-2 border-softYellow-400 text-softYellow-950 text-xs font-sans font-bold shadow-2xs">
        <svg class="w-4 h-4 text-softYellow-900 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="8" width="18" height="4" rx="1"/>
          <path d="M12 8v13"/>
          <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
          <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
        </svg>
        <span>Hadiah Kustom & Kartu Segel Lilin</span>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 pb-12 border-b border-stone-200">
      <!-- Col 1: Brand Atelier & Visi -->
      <div class="space-y-3.5">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl overflow-hidden bg-softPink-100 border border-softPink-300 shrink-0">
            <img
              src="/images/pearl_profile_avatar.jpg"
              alt={`${studio.name} Logo`}
              width="36"
              height="36"
              style="width: 100%; height: 100%; object-fit: cover;"
              class="w-full h-full object-cover rounded-xl"
              loading="lazy"
            />
          </div>
          <span class="font-serif text-lg font-bold text-stone-900 tracking-tight">
            {studio.name}
          </span>
        </div>
        <p class="text-xs text-stone-500 leading-relaxed">
          Atelier perangkai buket bunga tangan estetik untuk momen sakral pernikahan, lamaran, wisuda, dan hadiah personal berstandar artisanal di Slawi, Tegal & sekitarnya.
        </p>
      </div>

      <!-- Col 2: Jangkauan Wilayah & Kurir -->
      <div class="space-y-3 text-xs text-stone-600">
        <p class="font-semibold text-stone-900 text-sm font-serif">
          Lokasi & Wilayah Kurir
        </p>
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-softGreen-800 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <span class="leading-relaxed">{studio.location}</span>
        </div>
        <p class="text-[11px] text-stone-500 leading-relaxed pl-6.5">
          Tersedia pengiriman kurir roda dua instan khusus buket segar dan ekspedisi kargo kardus tebal untuk bunga abadi.
        </p>
      </div>

      <!-- Col 3: Jam Kerja & Kebijakan -->
      <div class="space-y-3 text-xs text-stone-600">
        <p class="font-semibold text-stone-900 text-sm font-serif">
          Jadwal Atelier
        </p>
        <div class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-softBlue-800 shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span>{studio.operatingHours}</span>
        </div>
        <p class="text-[11px] text-stone-500 leading-relaxed pl-6.5">
          Layanan konsultasi daring via WhatsApp tetap merespons di luar jam operasional untuk antrean pesanan esok hari.
        </p>
      </div>

      <!-- Col 4: Kontak Resmi & Kanal Sosial (WhatsApp, Instagram, Threads, X) -->
      <div class="space-y-3">
        <p class="font-semibold text-stone-900 text-sm font-serif">
          Kontak Resmi Atelier
        </p>
        <div class="flex flex-col gap-2.5 text-xs">
          <!-- WhatsApp -->
          <a
            href={consultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 text-softGreen-900 hover:text-softGreen-950 font-bold transition-colors"
          >
            <svg class="w-4 h-4 text-softGreen-800 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.891.815 2.796.815 3.183 0 5.769-2.586 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0-2c4.288 0 7.77 3.479 7.772 7.768 0 4.288-3.482 7.768-7.772 7.768-1.289 0-2.518-.32-3.606-.889l-4.425 1.159 1.185-4.328c-.655-1.139-1.002-2.434-1.002-3.71 0-4.289 3.483-7.768 7.772-7.768z"/>
            </svg>
            <span>WhatsApp: {studio.whatsappDisplay}</span>
          </a>

          <!-- Instagram -->
          <a
            href={studio.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 text-stone-700 hover:text-stone-950 font-semibold transition-colors"
          >
            <svg class="w-4 h-4 text-stone-700 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
            </svg>
            <span>Instagram: {studio.handle}</span>
          </a>

          <!-- Threads -->
          {studio.threadsUrl && (
            <a
              href={studio.threadsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 text-stone-700 hover:text-stone-950 font-semibold transition-colors"
            >
              <svg class="w-4 h-4 text-stone-700 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.186 20.916c-4.811 0-8.729-3.918-8.729-8.73 0-4.811 3.918-8.729 8.729-8.729 4.812 0 8.73 3.918 8.73 8.73 0 2.247-.852 4.303-2.28 5.864l-1.503-1.378c1.085-1.187 1.733-2.757 1.733-4.486 0-3.684-2.996-6.68-6.68-6.68-3.684 0-6.68 2.996-6.68 6.68 0 3.683 2.996 6.679 6.68 6.679 2.502 0 4.686-1.381 5.823-3.428l1.789.992c-1.505 2.709-4.398 4.54-7.662 4.54zm.004-5.362c-1.853 0-3.359-1.507-3.359-3.36 0-1.854 1.506-3.36 3.359-3.36 1.854 0 3.36 1.506 3.36 3.36 0 .524-.122 1.02-.338 1.464l-1.884-.715c.108-.231.171-.486.171-.749 0-.91-.74-1.65-1.65-1.65s-1.65.74-1.65 1.65.74 1.65 1.65 1.65c.348 0 .671-.108.938-.293l1.196 1.488c-.628.508-1.423.815-2.293.815z"/>
              </svg>
              <span>Threads: {studio.threadsHandle || '@pearl.storeflowers'}</span>
            </a>
          )}

          <!-- X (Twitter) -->
          {studio.xUrl && (
            <a
              href={studio.xUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 text-stone-700 hover:text-stone-950 font-semibold transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-stone-700 shrink-0 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              <span>X (Twitter): {studio.xHandle || '@pearlflower64'}</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Back to Top -->
    <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-500">
      <p class="text-center sm:text-left">
        © 2026 Pearl Store Flowers. Dikembangkan oleh <span class="font-semibold text-stone-800">Rafly Ashraffi Rachmat</span>. Seluruh hak cipta dilindungi undang-undang.
      </p>

      <a
        href="#top"
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 font-medium transition-colors border border-stone-200"
      >
        <span>Kembali ke Atas</span>
        <svg class="w-3.5 h-3.5 text-stone-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="m18 15-6-6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
