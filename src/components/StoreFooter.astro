---
import type { StudioInfo } from '../domain/types';
import { createWhatsAppConsultLink } from '../application/whatsapp';

interface Props {
  studio: StudioInfo;
}

const { studio } = Astro.props;
const consultWaUrl = createWhatsAppConsultLink(studio);
---

<footer class="w-full bg-botanical-950 text-[#D0E2D6] border-t border-botanical-900 mt-16 pt-12 pb-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pb-10 border-b border-botanical-900">
      <!-- Brand Col -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-botanical-900 border border-botanical-700 text-[#A8D5BA] flex items-center justify-center">
            <svg width="20" height="20" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 1 1 4.5 4.5 4.5 4.5 0 1 1-4.5 4.5"></path>
              <path d="M12 7.5V9"></path>
              <path d="M7.5 12H9"></path>
              <path d="M16.5 12H15"></path>
              <path d="M12 16.5V15"></path>
            </svg>
          </div>
          <span class="font-serif text-lg font-bold text-white">
            {studio.name}
          </span>
        </div>
        <p class="text-xs text-[#9EBEA8] leading-relaxed">
          Studio perangkai buket bunga tangan estetik untuk momen sakral pernikahan, lamaran, kelulusan, dan hadiah personal berstandar artisanal.
        </p>
      </div>

      <!-- Operational & Location -->
      <div class="space-y-2 text-xs text-[#9EBEA8]">
        <p class="font-semibold text-white text-sm mb-3 font-serif">
          Lokasi & Layanan
        </p>
        <div class="flex items-start gap-2">
          <span>📍</span>
          <span>{studio.location}</span>
        </div>
        <div class="flex items-start gap-2">
          <span>🕒</span>
          <span>{studio.operatingHours}</span>
        </div>
      </div>

      <!-- Navigation & Contact -->
      <div class="space-y-3">
        <p class="font-semibold text-white text-sm font-serif">
          Kontak Resmi Atelier
        </p>
        <div class="flex flex-col gap-2 text-xs">
          <a
            href={consultWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[#A8D5BA] hover:text-white font-medium transition-colors"
          >
            <span>💬</span>
            <span>WhatsApp Admin: {studio.whatsappDisplay}</span>
          </a>
          <a
            href={studio.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-[#9EBEA8] hover:text-white transition-colors"
          >
            <span>📸</span>
            <span>Instagram: {studio.handle}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Back to Top -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#9EBEA8]">
      <p class="text-center sm:text-left">
        © 2026 Pearl Store Flowers. Dikembangkan oleh <span class="font-semibold text-white">Rafly Ashraffi Rachmat</span>. Seluruh hak cipta dilindungi undang-undang.
      </p>

      <a
        href="#top"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-botanical-900 hover:bg-botanical-800 text-white font-medium transition-colors border border-botanical-800"
      >
        <span>Kembali ke Atas</span>
        <span>↑</span>
      </a>
    </div>
  </div>
</footer>

