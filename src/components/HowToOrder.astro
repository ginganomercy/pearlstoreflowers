---
import type { StudioInfo } from '../domain/types';
import { createWhatsAppConsultLink } from '../application/whatsapp';

interface Props {
  studio: StudioInfo;
}

const { studio } = Astro.props;
const consultWaUrl = createWhatsAppConsultLink(studio, 'Pemesanan Custom');
---

<section
  id="cara-pesan"
  class="w-full bg-botanical-900 text-white py-12 px-5 sm:px-8 lg:px-10 rounded-3xl border border-botanical-700 shadow-xl my-14 max-w-7xl mx-auto space-y-9"
>
  <div class="text-center max-w-3xl mx-auto space-y-2.5">
    <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-[#A8D5BA] uppercase tracking-widest bg-botanical-800 px-3.5 py-1 rounded-full border border-botanical-700">
      <svg class="w-3.5 h-3.5 text-atelier-champagne" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
        <path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>
      </svg>
      Alur Transaksi & Pengiriman
    </span>
    <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white">
      Tata Cara Pemesanan di {studio.name}
    </h2>
    <p class="text-xs sm:text-sm text-[#D1E6D8] leading-relaxed">
      Proses pemesanan cepat dan mudah via WhatsApp dengan format otomatis yang siap diverifikasi oleh florist artisan kami.
    </p>
  </div>

  <!-- 4 Steps Grid in Balanced Botanical Cards (Expanded max-w-7xl) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
    <div class="p-5 rounded-2xl bg-botanical-800/80 border border-botanical-700 space-y-3 hover:bg-botanical-800 transition-colors">
      <div class="flex items-center justify-between">
        <div class="w-9 h-9 rounded-xl bg-botanical-700 text-[#A8D5BA] flex items-center justify-center font-mono font-bold text-xs border border-botanical-600">
          01
        </div>
        <svg class="w-5 h-5 text-[#A8D5BA]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
      </div>
      <h3 class="font-serif font-bold text-base text-white">Pilih Model Buket</h3>
      <p class="text-xs text-[#D1E6D8] leading-relaxed">
        Eksplorasi 38 desain foto buket bunga asli (Wedding, Lamaran, Wisuda, atau Kustom) di etalase resmi ini.
      </p>
    </div>

    <div class="p-5 rounded-2xl bg-botanical-800/80 border border-botanical-700 space-y-3 hover:bg-botanical-800 transition-colors">
      <div class="flex items-center justify-between">
        <div class="w-9 h-9 rounded-xl bg-botanical-700 text-[#A8D5BA] flex items-center justify-center font-mono font-bold text-xs border border-botanical-600">
          02
        </div>
        <svg class="w-5 h-5 text-[#A8D5BA]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
        </svg>
      </div>
      <h3 class="font-serif font-bold text-base text-white">Pesan via WhatsApp</h3>
      <p class="text-xs text-[#D1E6D8] leading-relaxed">
        Format draf pesan terisi otomatis lengkap dengan kode SKU dan nama produk, menghemat waktu tanpa ketik ulang.
      </p>
    </div>

    <div class="p-5 rounded-2xl bg-botanical-800/80 border border-botanical-700 space-y-3 hover:bg-botanical-800 transition-colors">
      <div class="flex items-center justify-between">
        <div class="w-9 h-9 rounded-xl bg-botanical-700 text-[#A8D5BA] flex items-center justify-center font-mono font-bold text-xs border border-botanical-600">
          03
        </div>
        <svg class="w-5 h-5 text-[#A8D5BA]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/>
        </svg>
      </div>
      <h3 class="font-serif font-bold text-base text-white">Konfirmasi Tanggal</h3>
      <p class="text-xs text-[#D1E6D8] leading-relaxed">
        Admin memverifikasi slot tanggal pengiriman, alamat penerima, dan draf tulisan kartu ucapan wax-seal personal Anda.
      </p>
    </div>

    <div class="p-5 rounded-2xl bg-botanical-800/80 border border-botanical-700 space-y-3 hover:bg-botanical-800 transition-colors">
      <div class="flex items-center justify-between">
        <div class="w-9 h-9 rounded-xl bg-botanical-700 text-[#A8D5BA] flex items-center justify-center font-mono font-bold text-xs border border-botanical-600">
          04
        </div>
        <svg class="w-5 h-5 text-[#A8D5BA]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
        </svg>
      </div>
      <h3 class="font-serif font-bold text-base text-white">Rangkaian Diantar</h3>
      <p class="text-xs text-[#D1E6D8] leading-relaxed">
        Buket dirangkai teliti, difoto sebelum dikirim ke chat Anda, lalu diantar via kurir instan atau ekspedisi aman.
      </p>
    </div>
  </div>

  <!-- Policy & Action Bar with Pure SVG Icons -->
  <div class="p-5 sm:p-6 rounded-2xl bg-botanical-950/70 border border-botanical-700 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
    <div class="flex items-start gap-3.5">
      <div class="w-9 h-9 rounded-xl bg-botanical-900 border border-botanical-700 flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-5 h-5 text-atelier-champagne" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
          <path d="M12 8v4"/><path d="M12 16h.01"/>
        </svg>
      </div>
      <div class="text-xs space-y-1">
        <p class="font-semibold text-white text-sm font-serif">
          Kebijakan Lead Time & Pengiriman
        </p>
        <p class="text-[#D1E6D8] leading-relaxed">
          Pesanan wedding & lamaran disarankan H-3. Buket wisuda & perayaan siap Same-Day sesuai ketersediaan slot harian.
        </p>
      </div>
    </div>

    <a
      href={consultWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-botanical-700 hover:bg-botanical-600 text-white font-mono text-xs font-semibold whitespace-nowrap border border-botanical-500 shadow-xs transition-colors shrink-0"
    >
      <span>Tanya Ketersediaan Slot</span>
      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>
