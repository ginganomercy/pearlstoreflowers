---
import type { StudioInfo } from '../domain/types';
import { createWhatsAppConsultLink } from '../application/whatsapp';

interface Props {
  studio: StudioInfo;
}

const { studio } = Astro.props;
const consultWaUrl = createWhatsAppConsultLink(studio, 'Pemesanan Custom');
---

<section
  id="cara-pesan"
  class="w-full bg-white text-stone-900 py-12 sm:py-16 px-6 sm:px-10 lg:px-12 rounded-3xl border border-stone-200/90 shadow-xs my-16 max-w-7xl mx-auto space-y-12"
>
  <div class="text-center max-w-2xl mx-auto space-y-3">
    <p class="text-xs font-sans font-semibold tracking-[0.25em] uppercase text-softGreen-800">
      Panduan Pemesanan
    </p>
    <h2 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-stone-900">
      Empat Langkah Reservasi Rangkaian
    </h2>
    <p class="text-xs sm:text-sm text-stone-600 leading-relaxed max-w-xl mx-auto">
      Setiap karya bunga dirangkai segar oleh florist kami menjelang waktu pengiriman dengan konfirmasi praktis dan personal via WhatsApp.
    </p>
  </div>

  <!-- 4 Steps Grid: 4 Solid Soft Colors (Zero Gradient Policy) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Step 01: Soft Pink -->
    <div class="p-6 rounded-2xl bg-softPink-50 border border-softPink-200 space-y-4 hover:bg-softPink-100/70 transition-all">
      <div class="flex items-center justify-between">
        <span class="font-serif text-3xl font-bold text-softPink-300">01</span>
        <div class="w-8 h-8 rounded-lg bg-white border border-softPink-200 text-softPink-700 flex items-center justify-center shadow-2xs">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
      </div>
      <h3 class="font-serif font-bold text-base text-softPink-800">Pilih Model Buket</h3>
      <p class="text-xs text-stone-600 leading-relaxed">
        Eksplorasi koleksi portofolio buket bunga asli (Wedding, Lamaran, Wisuda, atau Kustom) di katalog ini.
      </p>
    </div>

    <!-- Step 02: Soft Green -->
    <div class="p-6 rounded-2xl bg-softGreen-50 border border-softGreen-200 space-y-4 hover:bg-softGreen-100/70 transition-all">
      <div class="flex items-center justify-between">
        <span class="font-serif text-3xl font-bold text-softGreen-300">02</span>
        <div class="w-8 h-8 rounded-lg bg-white border border-softGreen-200 text-softGreen-700 flex items-center justify-center shadow-2xs">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/>
          </svg>
        </div>
      </div>
      <h3 class="font-serif font-bold text-base text-softGreen-800">Pesan via WhatsApp</h3>
      <p class="text-xs text-stone-600 leading-relaxed">
        Klik tombol pesan pada buket yang diinginkan. Draf pesan otomatis memuat SKU dan nama rangkaian.
      </p>
    </div>

    <!-- Step 03: Soft Blue -->
    <div class="p-6 rounded-2xl bg-softBlue-50 border border-softBlue-200 space-y-4 hover:bg-softBlue-100/70 transition-all">
      <div class="flex items-center justify-between">
        <span class="font-serif text-3xl font-bold text-softBlue-300">03</span>
        <div class="w-8 h-8 rounded-lg bg-white border border-softBlue-200 text-softBlue-700 flex items-center justify-center shadow-2xs">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="m9 16 2 2 4-4"/>
          </svg>
        </div>
      </div>
      <h3 class="font-serif font-bold text-base text-softBlue-800">Konfirmasi Tanggal</h3>
      <p class="text-xs text-stone-600 leading-relaxed">
        Florist memverifikasi jadwal pengiriman, alamat penerima, dan pesan ucapan personal bersegel lilin Anda.
      </p>
    </div>

    <!-- Step 04: Soft Kuning -->
    <div class="p-6 rounded-2xl bg-softYellow-50 border border-softYellow-200 space-y-4 hover:bg-softYellow-100/70 transition-all">
      <div class="flex items-center justify-between">
        <span class="font-serif text-3xl font-bold text-softYellow-300">04</span>
        <div class="w-8 h-8 rounded-lg bg-white border border-softYellow-200 text-softYellow-700 flex items-center justify-center shadow-2xs">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
          </svg>
        </div>
      </div>
      <h3 class="font-serif font-bold text-base text-softYellow-800">Rangkaian Diantar</h3>
      <p class="text-xs text-stone-600 leading-relaxed">
        Buket difoto sebelum pengiriman untuk persetujuan Anda, lalu diantar dengan kurir terpercaya.
      </p>
    </div>
  </div>

  <!-- Policy & Action Bar in Solid Soft Green (Zero Gradient Policy) -->
  <div class="p-6 sm:p-7 rounded-2xl bg-softGreen-50 text-stone-900 flex flex-col sm:flex-row sm:items-center justify-between gap-5 border border-softGreen-200">
    <div class="flex items-start gap-3.5">
      <div class="w-9 h-9 rounded-xl bg-white border border-softGreen-200 flex items-center justify-center shrink-0 mt-0.5 text-softGreen-700 shadow-2xs">
        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
          <path d="M12 8v4"/><path d="M12 16h.01"/>
        </svg>
      </div>
      <div class="text-xs space-y-1">
        <p class="font-serif font-bold text-softGreen-800 text-sm">
          Kebijakan Waktu Pengerjaan & Pengiriman
        </p>
        <p class="text-stone-600 leading-relaxed">
          Pesanan wedding & lamaran disarankan reservasi H-3. Buket wisuda & perayaan siap Same-Day sesuai slot harian.
        </p>
      </div>
    </div>

    <a
      href={consultWaUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-softGreen-800 hover:bg-softGreen-700 text-white font-sans text-xs font-semibold tracking-wide shadow-xs transition-colors shrink-0"
    >
      <span>Tanya Ketersediaan Slot</span>
      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>
