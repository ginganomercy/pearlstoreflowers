---
import type { StudioInfo } from '../domain/types';
import { createWhatsAppConsultLink } from '../application/whatsapp';

interface Props {
  studio: StudioInfo;
  totalProducts?: number;
}

const { studio, totalProducts = 38 } = Astro.props;
const consultWaUrl = createWhatsAppConsultLink(studio);
---

<header class="w-full bg-white border-b-2 border-stone-200">
  <!-- Top Announcement Bar in Rich Solid Soft Green (Zero Gradient Policy) -->
  <div class="w-full bg-softGreen-200 text-softGreen-950 border-b-2 border-softGreen-400 py-2.5 px-4 text-center">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 sm:gap-4 flex-wrap text-xs font-sans">
      <span class="inline-flex items-center gap-1.5 font-bold text-softGreen-950 px-3.5 py-1 rounded-full bg-white border-2 border-softGreen-400 shadow-2xs">
        <span>Pengiriman Sameday & Terjadwal (Area Slawi, Tegal & Brebes)</span>
      </span>
      <span class="text-softGreen-500 hidden sm:inline">•</span>
      <span class="inline-flex items-center gap-1.5 font-bold text-softPink-950 px-3.5 py-1 rounded-full bg-softPink-200 border-2 border-softPink-400 shadow-2xs">
        <span>Kurasi Tangkai Segar & Bunga Abadi</span>
      </span>
      <span class="text-softGreen-500 hidden sm:inline">•</span>
      <span class="inline-flex items-center gap-1.5 font-bold text-softYellow-950 px-3.5 py-1 rounded-full bg-softYellow-200 border-2 border-softYellow-400 shadow-2xs">
        <span>Gratis Kartu Ucapan Segel Lilin</span>
      </span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-8 space-y-7">
    <!-- Brand Main Identity -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-start sm:items-center gap-4">
        <!-- Atelier Brand Identity: Authentic Official Instagram Avatar -->
        <a
          href="/"
          style="min-width: 4.5rem; min-height: 4.5rem;"
          class="w-18 h-18 sm:w-20 sm:h-20 rounded-2xl overflow-hidden bg-softPink-200 border-2 border-softPink-400 shadow-xs shrink-0 transition-transform duration-300 hover:scale-105 relative group block"
          aria-label="Pearl Store Flowers Beranda"
        >
          <img
            src="/images/pearl_profile_avatar.jpg"
            alt={`${studio.name} Official Atelier Avatar`}
            width="80"
            height="80"
            style="width: 100%; height: 100%; object-fit: cover;"
            class="w-full h-full object-cover rounded-2xl"
            loading="eager"
            fetchpriority="high"
          />
        </a>

        <div class="space-y-1">
          <div class="flex items-center gap-3 flex-wrap">
            <a href="/" class="hover:text-softGreen-800 transition-colors">
              <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-stone-900">
                {studio.name}
              </h1>
            </a>
            <span class="text-xs font-serif italic text-softPink-950 bg-softPink-200 px-3 py-0.5 rounded-full border-2 border-softPink-400 tracking-wide font-bold">
              Floral & Bouquet Atelier • Est. 2024
            </span>
          </div>

          <p class="text-xs sm:text-sm text-stone-700 font-medium">
            {studio.tagline} — Spesialis Rangkaian Buket Pengantin, Lamaran, & Hadiah Seremonial
          </p>

          <!-- Location & Operational Hours with Bold Thick SVG Icons -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-4 text-xs text-stone-600 pt-1">
            <span class="inline-flex items-center gap-1.5 text-softGreen-950 font-bold">
              <svg class="w-4 h-4 text-softGreen-800 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>{studio.location}</span>
            </span>
            <span class="hidden sm:inline text-stone-300">•</span>
            <span class="inline-flex items-center gap-1.5 text-stone-700 font-medium">
              <svg class="w-4 h-4 text-stone-600 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>{studio.operatingHours}</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons: Multi-Channel Concierge (WhatsApp, Instagram, Threads, X) -->
      <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap shrink-0">
        <a
          href={consultWaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4.5 py-2.5 rounded-xl bg-softGreen-800 hover:bg-softGreen-900 text-white text-xs font-bold shadow-xs hover:shadow transition-all border border-softGreen-900 active:scale-[0.98]"
          title="Konsultasi cepat via WhatsApp resmi"
        >
          <svg class="w-4 h-4 fill-white shrink-0" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.891.815 2.796.815 3.183 0 5.769-2.586 5.77-5.766.001-3.182-2.585-5.768-5.77-5.768zm0-2c4.288 0 7.77 3.479 7.772 7.768 0 4.288-3.482 7.768-7.772 7.768-1.289 0-2.518-.32-3.606-.889l-4.425 1.159 1.185-4.328c-.655-1.139-1.002-2.434-1.002-3.71 0-4.289 3.483-7.768 7.772-7.768z"/>
          </svg>
          <span>Chat WhatsApp</span>
        </a>

        <!-- Instagram Pill -->
        <a
          href={studio.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-softPink-100 hover:bg-softPink-200 text-softPink-950 text-xs font-bold transition-all border-2 border-softPink-300 shadow-2xs active:scale-[0.98]"
          title="Kunjungi Instagram resmi @pearl.storeflowers"
        >
          <svg class="w-4 h-4 text-softPink-900 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
          <span class="hidden md:inline">IG</span>
        </a>

        <!-- Threads Pill -->
        {studio.threadsUrl && (
          <a
            href={studio.threadsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-softBlue-100 hover:bg-softBlue-200 text-softBlue-950 text-xs font-bold transition-all border-2 border-softBlue-300 shadow-2xs active:scale-[0.98]"
            title="Kunjungi Threads resmi @pearl.storeflowers"
          >
            <svg class="w-4 h-4 text-softBlue-900 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.186 20.916c-4.811 0-8.729-3.918-8.729-8.73 0-4.811 3.918-8.729 8.729-8.729 4.812 0 8.73 3.918 8.73 8.73 0 2.247-.852 4.303-2.28 5.864l-1.503-1.378c1.085-1.187 1.733-2.757 1.733-4.486 0-3.684-2.996-6.68-6.68-6.68-3.684 0-6.68 2.996-6.68 6.68 0 3.683 2.996 6.679 6.68 6.679 2.502 0 4.686-1.381 5.823-3.428l1.789.992c-1.505 2.709-4.398 4.54-7.662 4.54zm.004-5.362c-1.853 0-3.359-1.507-3.359-3.36 0-1.854 1.506-3.36 3.359-3.36 1.854 0 3.36 1.506 3.36 3.36 0 .524-.122 1.02-.338 1.464l-1.884-.715c.108-.231.171-.486.171-.749 0-.91-.74-1.65-1.65-1.65s-1.65.74-1.65 1.65.74 1.65 1.65 1.65c.348 0 .671-.108.938-.293l1.196 1.488c-.628.508-1.423.815-2.293.815z"/>
            </svg>
            <span class="hidden md:inline">Threads</span>
          </a>
        )}

        <!-- X (Twitter) Pill -->
        {studio.xUrl && (
          <a
            href={studio.xUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-900 text-xs font-bold transition-all border-2 border-stone-300 shadow-2xs active:scale-[0.98]"
            title="Kunjungi akun X resmi @pearlflower64"
          >
            <svg class="w-3.5 h-3.5 text-stone-900 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span class="hidden md:inline">X</span>
          </a>
        )}
      </div>
    </div>

    <!-- Atelier Core Value Pillars: 4 Rich Solid Soft Colors & Thick Bold Vector Icons (Zero Gradient Policy) -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 pt-2">
      <!-- Pillar 1: Rich Soft Green (100% Solid Opacity) -->
      <div class="flex items-center gap-3 p-4 rounded-2xl bg-softGreen-200 border-2 border-softGreen-400 hover:bg-softGreen-300 transition-all shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-white border-2 border-softGreen-400 text-softGreen-900 flex items-center justify-center shadow-xs shrink-0">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div class="text-[11px] leading-tight">
          <p class="font-bold text-softGreen-950 font-serif text-xs">Kurasi Bunga Segar</p>
          <p class="text-softGreen-900 font-semibold">Kuntum pilihan mekar sempurna</p>
        </div>
      </div>

      <!-- Pillar 2: Rich Soft Pink (100% Solid Opacity) -->
      <div class="flex items-center gap-3 p-4 rounded-2xl bg-softPink-200 border-2 border-softPink-400 hover:bg-softPink-300 transition-all shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-white border-2 border-softPink-400 text-softPink-900 flex items-center justify-center shadow-xs shrink-0">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h9"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            <path d="m16 19 2 2 4-4"/>
          </svg>
        </div>
        <div class="text-[11px] leading-tight">
          <p class="font-bold text-softPink-950 font-serif text-xs">Kartu Bersegel Lilin</p>
          <p class="text-softPink-900 font-semibold">Surat ucapan elegan gratis</p>
        </div>
      </div>

      <!-- Pillar 3: Rich Soft Blue (100% Solid Opacity) -->
      <div class="flex items-center gap-3 p-4 rounded-2xl bg-softBlue-200 border-2 border-softBlue-400 hover:bg-softBlue-300 transition-all shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-white border-2 border-softBlue-400 text-softBlue-900 flex items-center justify-center shadow-xs shrink-0">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div class="text-[11px] leading-tight">
          <p class="font-bold text-softBlue-950 font-serif text-xs">Layanan Sameday</p>
          <p class="text-softBlue-900 font-semibold">Slot instan harian tersedia</p>
        </div>
      </div>

      <!-- Pillar 4: Rich Soft Kuning (100% Solid Opacity) -->
      <div class="flex items-center gap-3 p-4 rounded-2xl bg-softYellow-200 border-2 border-softYellow-400 hover:bg-softYellow-300 transition-all shadow-2xs">
        <div class="w-10 h-10 rounded-xl bg-white border-2 border-softYellow-400 text-softYellow-900 flex items-center justify-center shadow-xs shrink-0">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="m7.5 4.27 9 5.15"/>
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
            <path d="m3.3 7 8.7 5 8.7-5"/>
            <path d="M12 22V12"/>
          </svg>
        </div>
        <div class="text-[11px] leading-tight">
          <p class="font-bold text-softYellow-950 font-serif text-xs">Proteksi Buket Aman</p>
          <p class="text-softYellow-900 font-semibold">Hardbox kokoh menjaga bentuk</p>
        </div>
      </div>
    </div>
  </div>
</header>
